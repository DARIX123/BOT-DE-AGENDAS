# ─── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ─── Instagram ────────────────────────────────────────────────────────────────
INSTAGRAM_VERIFY_TOKEN=your_verify_token_here
INSTAGRAM_ACCESS_TOKEN=your_page_access_token_here

# ─── Negocio ──────────────────────────────────────────────────────────────────
# Días laborales (0=lunes … 6=domingo)
BUSINESS_OPEN_DAYS=0,1,2,3,4,5
# Horario (24h)
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=20
# Duración estándar de cita en minutos
DEFAULT_SLOT_MINUTES=45

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
